<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/s_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical">
    <TextView android:id="@+id/s_tier" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="3. Liga" android:textColor="#FF8C8C92" android:textSize="11sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:letterSpacing="0.06"/>
    <TextView android:id="@+id/s_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="#FFFFFFFF" android:textSize="34sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:layout_marginTop="6dp"/>
    <TextView android:id="@+id/s_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DAYS" android:textColor="#FF8C8C92" android:textSize="10sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:letterSpacing="0.08" android:layout_marginTop="2dp"/>
    <ProgressBar android:id="@+id/s_prog" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
            android:layout_height="5dp" android:layout_marginTop="12dp" android:max="100" android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />
</LinearLayout>
