<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/b_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="18dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/b_tier" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="3. Liga" android:textColor="#FFFFFFFF" android:textSize="22sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:id="@+id/b_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="A1" android:textColor="#FF8C8C92" android:textSize="12sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:layout_marginTop="3dp"/>
        </LinearLayout>
    <TextView android:id="@+id/b_lp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0 LP" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
    </LinearLayout>
    <ProgressBar android:id="@+id/b_prog" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
            android:layout_height="5dp" android:layout_marginTop="12dp" android:max="100" android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="22dp" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:orientation="vertical">
            <TextView android:id="@+id/b_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="#FFFF3B47" android:textSize="30sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/b_l_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="STREAK" android:textColor="#FF8C8C92" android:textSize="10sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:letterSpacing="0.08" android:layout_marginTop="2dp"/>
        </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/b_due" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="#FFFFFFFF" android:textSize="30sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/b_l_due" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DUE" android:textColor="#FF8C8C92" android:textSize="10sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:letterSpacing="0.08" android:layout_marginTop="2dp"/>
        </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/b_new" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="#FFFFFFFF" android:textSize="30sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/b_l_new" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NEW" android:textColor="#FF8C8C92" android:textSize="10sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:letterSpacing="0.08" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp">
    <TextView android:id="@+id/d0" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="-" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFBBBBBB" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/d1" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="-" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFBBBBBB" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/d2" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="-" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFBBBBBB" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/d3" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="-" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFBBBBBB" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/d4" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="-" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFBBBBBB" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/d5" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="-" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFBBBBBB" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/d6" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:gravity="center" android:text="-" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFBBBBBB" android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/b_goals" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/b_l_goals" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GOALS" android:textColor="#FF8C8C92" android:textSize="10sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:letterSpacing="0.08" android:layout_marginTop="2dp"/>
        </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/b_xg" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0.0" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/b_l_xg" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="xG" android:textColor="#FF8C8C92" android:textSize="10sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:letterSpacing="0.08" android:layout_marginTop="2dp"/>
        </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:orientation="vertical">
            <TextView android:id="@+id/b_cs" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/b_l_cs" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CLEAN SHEETS" android:textColor="#FF8C8C92" android:textSize="10sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:letterSpacing="0.08" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/b_tro" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Trophies  0 · 0 · 0" android:textColor="#FF8C8C92" android:textSize="12sp" android:textStyle="bold"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:layout_marginTop="18dp"/>
</LinearLayout>
