{
  "name": "kobel-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kobel sync API: a Cloudflare Worker backed by a D1 database (free tier).",
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kobel-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kobel-db --remote",
    "test": "node --test --no-warnings test/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
